{
    "name": "alextesta00/four-street-site",
    "description": "Sito di 4Street, palestra a San Marino",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "FourStreet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FourStreet\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "php-cs-fixer check --diff",
        "format": "php-cs-fixer fix",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "lint": "Controlla lo stile del codice PHP senza modificarlo (PHP-CS-Fixer).",
        "format": "Sistema lo stile del codice PHP (PHP-CS-Fixer).",
        "analyse": "Analisi statica al livello massimo (PHPStan).",
        "test": "Esegue i test (PHPUnit).",
        "check": "Stile, analisi statica e test: quello che esegue la CI."
    }
}
