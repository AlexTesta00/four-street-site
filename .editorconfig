# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# PHP: PER Coding Style, quattro spazi (lo controlla PHP-CS-Fixer)
[*.php]
indent_size = 4

# Template: il markup HTML è rientrato di due spazi
[templates/**.php]
indent_size = 2

# Composer scrive composer.json con quattro spazi; così anche le configurazioni di PHPUnit e PHPStan
[{composer.json,*.xml,*.xml.dist,*.neon,*.neon.dist}]
indent_size = 4

# In Markdown due spazi a fine riga vanno a capo
[*.md]
trim_trailing_whitespace = false
