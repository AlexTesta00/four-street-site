<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test PHP del sito. Il fuso orario predefinito è volutamente esotico (UTC+14):
  il codice deve usare sempre il fuso di config/site.php, mai quello della macchina.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         executionOrder="random"
         requireCoverageMetadata="true"
         beStrictAboutOutputDuringTests="true"
         failOnEmptyTestSuite="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         failOnPhpunitNotice="true"
         failOnPhpunitWarning="true"
         displayDetailsOnAllIssues="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source restrictNotices="true" restrictWarnings="true" ignoreIndirectDeprecations="true">
        <include>
            <directory>src</directory>
        </include>
    </source>

    <php>
        <ini name="error_reporting" value="-1"/>
        <ini name="date.timezone" value="Pacific/Kiritimati"/>
    </php>
</phpunit>
